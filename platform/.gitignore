# 忽略文件的详细说明见 https://help.github.com/articles/ignoring-files/

# 依赖
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 测试输出
/coverage

# Next.js 构建输出
/.next/
/.vinext/
/out/

# 其他文件
.DS_Store
*.pem

# 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 环境变量文件（需要时可选择提交）
.env*

# Vercel 配置
.vercel

# TypeScript 生成文件
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# 本地 Python 运行环境和私有分析数据
/.venv/
/data/*
!/data/.gitkeep
/.run/
/.run-pip.*
/logs/
__pycache__/
*.py[cod]
*.db
*.sqlite*
