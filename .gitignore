*.docx

# 生成的分析数据
platform/data/*
!platform/data/.gitkeep
*.db
*.sqlite
*.sqlite3

# Python 运行环境
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node、Vinext、Vite 和 Cloudflare 构建文件
node_modules/
.vinext/
.next/
dist/
.wrangler/
*.tsbuildinfo
platform/.run/
platform/logs/

# 环境变量与密钥
.env
.env.*
!.env.example
*.pem
*.key

# 编辑器、操作系统与日志
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# OneDrive 临时文件
~$*
*.tmp

